# ── Required ──────────────────────────────────────────────────────────────────
# Gemini API key for AI vocabulary generation and Quick Translate features.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Turso / libSQL (cloud database — optional) ────────────────────────────────
# When BOTH variables below are set, the app connects to your Turso cloud DB.
# When left blank, the app falls back to the local vocab.db SQLite file.
#
# Get these from your Turso dashboard:  https://turso.tech
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here
